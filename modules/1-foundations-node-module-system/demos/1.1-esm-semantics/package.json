{
  "name": "demo-1.1-esm-semantics",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p packages/app/tsconfig.json --noEmit",
    "build": "tsc -b packages/app",
    "demo": "pnpm -s demo:bindings && pnpm -s demo:hoisting && pnpm -s demo:scope && pnpm -s demo:tla",
    "demo:bindings": "node packages/app/dist/live-bindings.js",
    "demo:hoisting": "node packages/app/dist/hoisting.js",
    "demo:scope": "node packages/app/scope.mjs && node packages/app/scope.cjs",
    "demo:tla": "node packages/app/require-esm.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}
