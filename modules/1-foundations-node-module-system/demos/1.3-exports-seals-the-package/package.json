{
  "name": "demo-1.3-exports-seals-the-package",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p packages/app-esm/tsconfig.json --noEmit && tsc -p packages/app-cjs/tsconfig.json --noEmit",
    "build": "tsc -b packages/app-esm packages/app-cjs",
    "demo": "pnpm -s demo:esm && echo && pnpm -s demo:cjs",
    "demo:esm": "node packages/app-esm/dist/main.js",
    "demo:cjs": "node packages/app-cjs/dist/main.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}
