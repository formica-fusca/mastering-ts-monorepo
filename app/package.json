{
  "name": "mastering-ts-monorepo-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @site/content build && pnpm --filter @site/web dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "preview": "pnpm --filter @site/web preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}
